# Which LLM parses natural-language chat updates ("I learned Rust today")
# into a structured profile delta. "anthropic" or "glm" — set the matching
# key below, the other one can stay unset.
AI_PROVIDER=anthropic

# Required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# Required if AI_PROVIDER=glm (get a key at https://z.ai/chat)
# GLM_API_KEY=...
# Default is glm-4.7-flash (free tier, ~1 req/s, ~1000 req/day). glm-5.3 is
# the paid flagship ($1.40/$4.40 per MTok) — set this once you're funded.
# GLM_MODEL=glm-4.7-flash

PORT=6366
DB_PATH=./resync.db
